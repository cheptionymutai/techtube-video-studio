{
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/verify",
        "destination": "/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/sitemap.xml",
        "run": {
          "serviceId": "cheptiony-backend",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/post.html"
      }
    ]
  }
}
