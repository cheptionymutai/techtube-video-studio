{
  "hosting": {
    "site": "techtube-site",
    "public": "public",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
  { "source": "/verify", "destination": "/", "type": 301 },
  { "source": "/livestream", "destination": "/", "type": 301 },
  { "source": "/livestream.html", "destination": "/", "type": 301 }
],
    "rewrites": [
      {
        "source": "/sitemap.xml",
        "run": {
          "serviceId": "techtube-backend",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/post.html"
      }
    ]
  }
}